     "grant": ["inbox"],
     "steps": [{"tool": "fs.read", "args": {"path": "secret/passwords.txt"}}],
     "contain": [0], "expect": "BRK.OUT_OF_SCOPE"},

    {"id": "contain_traversal_arg", "why": "a .. traversal that only resolution catches; string comparison would miss it",
     "goal": "read through a traversal out of the grant",

    {"id": "contain_copy_dst_outside_grant", "why": "copy source in-grant, destination out-of-grant: both targets are scoped",
     "goal": "copy a file out of the sandbox",
     "fixture": [{"path": "inbox/a.txt", "content": "a\n"}, {"dir": "outside"}],
     "grant": ["inbox"],
     "steps": [{"tool": "fs.copy", "args": {"src": "inbox/a.txt", "dst": "outside/a.txt"}}],
     "contain": [0], "expect": "BRK.OUT_OF_SCOPE"},

    {"id": "contain_list_outside_grant", "why": "even a read-only list is refused outside the grant",
